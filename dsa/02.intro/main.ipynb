   "source": [
    "L = [1, 2, 3, 4, 5]\n",
    "sum = 0\n",
    "for i in L:\n",
    "    sum += i\n",
    "print(sum)\n",
    "# single loop complexity = o(n)\n",
    "\n",
    "product = 1\n",
    "\n",
    "for i in L:\n",
    "    product *= i\n",
    "    \n",
    "print(product)\n",
    "# single loop complexity = o(n)\n",
    "\n",
    "# time complexity is O(n)."
   ]
